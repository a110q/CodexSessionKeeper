{
  "name": "codex-session-manager-win10-electron",
  "version": "1.0.13",
  "description": "Codex session manager for Windows 10",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "prepare:sqlite-win": "bash ../../scripts/prepare_windows_sqlite.sh",
    "package:win": "npm run prepare:sqlite-win && electron-packager . codex_session_manager --platform=win32 --arch=x64 --out=../../dist/win10-exe --overwrite --prune=true"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "26.15.3"
  }
}
