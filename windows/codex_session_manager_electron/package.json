{
  "name": "codex-session-manager-win10-electron",
  "version": "1.1.0",
  "updateBuild": 10100,
  "description": "Codex session manager for Windows 10",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "prepare:sqlite-win": "bash ../../scripts/prepare_windows_sqlite.sh",
    "package:win": "npm run prepare:sqlite-win && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.codex.session-manager",
    "electronDownload": {
      "unsafelyDisableChecksums": false,
      "checksums": {
        "electron-v43.1.0-win32-x64.zip": "a07dc1e3d5e589593d37e3b19d1b373e02bb58270e2eb0d6633eee0198ad09f0"
      }
    },
    "productName": "codex_会话管理",
    "artifactName": "CodexSessionKeeper-${version}-windows-${arch}-Setup.${ext}",
    "directories": {
      "output": "../../dist/windows"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../Config/UpdateKeys.json",
        "to": "UpdateKeys.json"
      },
      {
        "from": "../../Config/UpdateServer.json",
        "to": "UpdateServer.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://192.168.10.54:18080/codex-session-keeper/stable/windows/"
      }
    ]
  }
}
